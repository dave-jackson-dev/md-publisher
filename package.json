{
  "name": "md-publisher-workspace",
  "description": "Base workspace package",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dave-jackson-dev/md-publisher.git"
  },
  "scripts": {
    "clean": "npm run clean --workspaces",
    "watch": "tsc -b tsconfig.build.json --watch",
    "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
    "build:clean": "npm run clean && npm run build",
    "langium:generate": "npm run --workspace packages/language langium:generate",
    "langium:watch": "npm run --workspace packages/language langium:watch",
    "test": "npm run --workspace packages/language test && npm run --workspace packages/publishing test"
  },
  "devDependencies": {
    "@types/node": "~20.17.48",
    "shx": "~0.4.0",
    "typescript": "~5.8.3",
    "nx": "23.2.1"
  },
  "workspaces": [
    "packages/language",
    "packages/publishing",
    "packages/cli",
    "packages/extension"
  ]
}