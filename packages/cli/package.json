{
    "name": "md-publisher-cli",
    "description": "Validate a .mdpub Publication and generate DOCX, PDF, EPUB, and Web output from one source with one command.",
    "version": "0.0.1",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "markdown",
        "docs-as-code",
        "publishing",
        "docx",
        "pdf",
        "epub",
        "cli"
    ],
    "author": "Dave Jackson",
    "repository": {
        "type": "git",
        "url": "https://github.com/dave-jackson-dev/md-publisher.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/dave-jackson-dev/md-publisher/issues"
    },
    "homepage": "https://github.com/dave-jackson-dev/md-publisher#readme",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src"
    ],
    "bin": {
        "md-publisher-cli": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "vitest run"
    },
    "dependencies": {
        "md-publisher-publishing": "0.0.1",
        "chalk": "~5.3.0",
        "commander": "~11.1.0"
    },
    "devDependencies": {
        "vitest": "~3.1.3"
    }
}
