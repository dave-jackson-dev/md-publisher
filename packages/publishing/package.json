{
    "name": "md-publisher-publishing",
    "description": "The Publishing bounded context: compiles a validated Publication into DOCX, PDF, EPUB, and Web output",
    "version": "0.0.1",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "vitest run"
    },
    "dependencies": {
        "md-publisher-language": "0.0.1",
        "langium": "~4.2.0",
        "docx": "^9.5.1",
        "pdfkit": "^0.17.1",
        "jszip": "^3.10.1"
    },
    "devDependencies": {
        "@types/pdfkit": "^0.17.4",
        "vitest": "~3.1.3",
        "vscode-languageserver-types": "~3.17.5"
    }
}
