{
    "name": "vscode-md-publisher",
    "description": "Build-time structural validation for .mdpub documents, plus commands to open .mdpub files and publish a folder to DOCX/PDF/Web/EPUB.",
    "version": "0.0.1",
    "displayName": "md-publisher",
    "type": "module",
    "publisher": "TODO-set-marketplace-publisher-id",
    "license": "MIT",
    "icon": "resources/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/dave-jackson-dev/md-publisher.git",
        "directory": "packages/extension"
    },
    "bugs": {
        "url": "https://github.com/dave-jackson-dev/md-publisher/issues"
    },
    "engines": {
        "vscode": "^1.67.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "contributes": {
        "languages": [{
            "id": "md-publisher",
            "aliases": ["MD Publisher", "md-publisher"],
            "extensions": [".md",".mdpub"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "md-publisher",
            "scopeName": "source.md-publisher",
            "path": "syntaxes/md-publisher.tmLanguage.json"
        }],
        "commands": [
            {
                "command": "md-publisher.openAsMdpub",
                "title": "md-publisher: Open File...",
                "category": "md-publisher"
            },
            {
                "command": "md-publisher.publish",
                "title": "md-publisher: Publish",
                "category": "md-publisher"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "md-publisher.publish",
                    "when": "explorerResourceIsFolder",
                    "group": "6_md-publisher"
                }
            ],
            "commandPalette": [
                {
                    "command": "md-publisher.openAsMdpub"
                },
                {
                    "command": "md-publisher.publish",
                    "when": "false"
                }
            ]
        }
    },
    "activationEvents": [
        "onLanguage:md-publisher",
        "onCommand:md-publisher.openAsMdpub",
        "onCommand:md-publisher.publish"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes LICENSE",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/md-publisher.tmLanguage.json ./syntaxes/md-publisher.tmLanguage.json && shx cp -f ../../LICENSE ./LICENSE",
        "build:postprocess": "shx mkdir -p ./out/extension/data && shx cp -R ../../node_modules/pdfkit/js/data/. ./out/extension/data/",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs && npm run build:postprocess",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && npm run build:postprocess && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "dependencies": {
        "md-publisher-language": "0.0.1",
        "md-publisher-publishing": "0.0.1",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.67.0",
        "@vscode/vsce": "~4.0.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5"
    },
    "vsce": {
      "dependencies": false
    }
}
